<Bindings>
  <Binding name="JOURNEYKEEPER_PHOTO" header="JOURNEYKEEPER" category="ADDONS">
    if JourneykeeperAPI then JourneykeeperAPI.Photo.Take() end
  </Binding>
  <Binding name="JOURNEYKEEPER_PHOTO_SNAP" category="ADDONS">
    if JourneykeeperAPI then JourneykeeperAPI.Photo.Snap() end
  </Binding>
  <Binding name="JOURNEYKEEPER_PROFILE" category="ADDONS">
    if JourneykeeperAPI then JourneykeeperAPI.Profiles.Show() end
  </Binding>
  <Binding name="JOURNEYKEEPER_JOURNAL" category="ADDONS">
    if JourneykeeperAPI then JourneykeeperAPI.Journal.Toggle() end
  </Binding>
  <Binding name="JOURNEYKEEPER_JOURNEY" category="ADDONS">
    if JourneykeeperAPI and JourneykeeperAPI.Journal.Journey then JourneykeeperAPI.Journal.Journey() end
  </Binding>
  <Binding name="JOURNEYKEEPER_NOTE" category="ADDONS">
    if JourneykeeperAPI and JourneykeeperAPI.Notes then JourneykeeperAPI.Notes.Prompt() end
  </Binding>
  <Binding name="JOURNEYKEEPER_FELLOWSHIP" category="ADDONS">
    if JourneykeeperAPI and JourneykeeperAPI.Journal.Fellowship then JourneykeeperAPI.Journal.Fellowship() end
  </Binding>
</Bindings>
